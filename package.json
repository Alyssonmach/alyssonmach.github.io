{
  "name": "alyssonmach-academic-site",
  "description": "Site acadêmico de Alysson Machado em Jekyll",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alyssonmach/alyssonmach.github.io.git"
  },
  "keywords": [
    "jekyll",
    "academic",
    "portfolio"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alyssonmach/alyssonmach.github.io/issues"
  },
  "homepage": "https://alyssonmach.github.io",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  },
  "private": true
}
