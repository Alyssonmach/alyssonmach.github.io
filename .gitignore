# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the dependency lockfile generated locally
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/

# Ignore files created by MacOS
.DS_Store

# Python environments and bytecode
.venv/
__pycache__/
*.py[cod]

# Auxiliary files generated while compiling the CV with LaTeX.
# Keep cv-llt.pdf versioned because the CV page serves it directly.
files/CV-LaTeX/*.aux
files/CV-LaTeX/*.bbl
files/CV-LaTeX/*.bcf
files/CV-LaTeX/*.blg
files/CV-LaTeX/*.fdb_latexmk
files/CV-LaTeX/*.fls
files/CV-LaTeX/*.lof
files/CV-LaTeX/*.log
files/CV-LaTeX/*.lot
files/CV-LaTeX/*.nav
files/CV-LaTeX/*.out
files/CV-LaTeX/*.run.xml
files/CV-LaTeX/*.snm
files/CV-LaTeX/*.synctex.gz
files/CV-LaTeX/*.toc
files/CV-LaTeX/*.vrb
files/CV-LaTeX/*.xdv
